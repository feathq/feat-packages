{
  "name": "@feathq/feat-eval",
  "version": "0.1.0",
  "description": "Reference flag-evaluation engine for the feat feature-flag platform. The single authoritative implementation of the eval precedence, operators, segment matching, and bucketing.",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "feat",
    "evaluation",
    "openfeature"
  ],
  "license": "MIT",
  "author": "feat HQ <support@feat.so>",
  "homepage": "https://feat.so",
  "repository": {
    "type": "git",
    "url": "https://github.com/feathq/feat-packages",
    "directory": "feat-eval"
  },
  "bugs": {
    "url": "https://github.com/feathq/feat-packages/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@feathq/datafile-schema": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  }
}
